pipeline {
  agent any

  stages {
    stage('Build'){
      steps{
          dir('Amazon') {
          sh 'mvn clean package'
        }
      }
    }

stage('Deploy') {
  steps {
    sh '''
    scp -o StrictHostKeyChecking=no \
    -i /var/lib/jenkins/.ssh/A-vm-key \
    Amazon/Amazon-Web/target/*.war \
    azureuser@20.109.176.109:/home/azureuser/tomcat/apache-tomcat-9.0.115/webapps/
    '''
  }
}
    

    stage ('Restart Tomcat'){
      steps {
        sh 'scp -i azureuser@20.109.176.109 "/home/azureuser/tomcat/apache-tomcat-9.0.115/bin/shutdown.sh"'
        sh 'scp -i azureuser@20.109.176.109 "/home/azureuser/tomcat/apache-tomcat-9.0.115/bin/startup.sh"'  
      }
    }
  }
}
